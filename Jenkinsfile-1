pipeline {
    agent any
    tools {nodejs "node"}
    stages {
        stage('Cloning Repo') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/IA23a-tiberig/M324_trafficlight'
            }
        }
        stage('Install jest-cli') {
            steps {
                sh 'npm install jest-cli -g'
            }
        }
        stage('Install dependencies') {
            steps {
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
    }
}